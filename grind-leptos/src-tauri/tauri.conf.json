{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Grindstone",
	"version": "0.1.0",
	"identifier": "com.maeevick.grindstone",
	"build": {
		"beforeDevCommand": { "script": "trunk serve", "cwd": "../ui" },
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" },
		"frontendDist": "../ui/dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [{ "title": "Grindstone", "width": 420, "height": 860 }],
		"security": { "csp": null }
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
